{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "paths": {
      "@/lib/utils": ["./typecheck/utils.ts"],
      "@/lib/pdf-themes/muriki": ["./registry/muriki/pdf/theme.ts"],
      "@/lib/pdf-themes/*": ["./typecheck/pdfcn/lib/pdf-themes/*"],
      "@/lib/pdf-primitives": ["./typecheck/pdfcn/lib/pdf-primitives.tsx"],
      "@/lib/pdf-svg": ["./typecheck/pdfcn/lib/pdf-svg.tsx"],
      "@/lib/resolve-color": ["./typecheck/pdfcn/lib/resolve-color.ts"],
      "@/types/*": ["./typecheck/pdfcn/types/*"],
      "@/components/pdf/*": ["./typecheck/pdfcn/components/pdf/*"],
      "@/components/pdf-documents/*": ["./registry/muriki/pdf/*"],
      "@/lib/*": ["./registry/muriki/lib/*"],
      "@/components/ui/*": ["./registry/muriki/ui/*"],
      "@/components/blocks/*": ["./registry/muriki/blocks/*"],
      "@/components/ai/*": ["./registry/muriki/ai/*"],
      "@/components/acrylic/*": ["./registry/muriki/acrylic/*"]
    }
  },
  "include": ["registry/**/*.ts", "registry/**/*.tsx", "typecheck/**/*.ts", "typecheck/**/*.tsx"]
}
